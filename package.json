{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint resources/js tests/frontend",
        "format:check": "prettier --check 'resources/**/*.{ts,vue,css}' 'tests/frontend/**/*.{ts,vue}'"
    },
    "dependencies": {
        "vue": "^3.5.0",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.0",
        "eslint": "^9.0.0",
        "eslint-plugin-vue": "^10.0.0",
        "globals": "^16.0.0",
        "jsdom": "^26.0.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.2",
        "vue-tsc": "^3.0.0"
    }
