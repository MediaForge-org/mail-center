# Disposable local analysis; never application source.
/graphify-out/

# Secrets at any depth. Only a deliberately sanitized example may be versioned.
.env
.env.*
!.env.example
*.pem
*.key
/secrets/

# Future framework/build/runtime output (M0 does not create these).
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage
# storage/ is tracked only as empty placeholders; each directory's own .gitignore excludes its contents.
/bootstrap/cache/*.php
/coverage/
/test-results/
/playwright-report/
/backups/
*.log
.phpunit.result.cache
.phpunit.cache/
.DS_Store
